name: Supabase Database CI
on: [push, pull_request]

jobs:
  database-tests:
    runs-on: ubuntu-latest
    
    env:
      SUPABASE_URL: https://wizyuwbezyltaxatkupc.supabase.co
      SUPABASE_SERVICE_ROLE_KEY: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Indpenl1d2JlenlsdGF4YXRrdXBjIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc1MzEwNzUzOCwiZXhwIjoyMDY4NjgzNTM4fQ.vFHnozyg-q-St6W5hFQljs5SsFI1r169fLj21_MnyCw
      SUPABASE_ANON_KEY: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Indpenl1d2JlenlsdGF4YXRrdXBjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTMxMDc1MzgsImV4cCI6MjA2ODY4MzUzOH0.akCyzqHG4LIhboUBy36djCKHjRVDfb5KoTPNiIY3AtA 

    steps:
    - uses: actions/checkout@v3

    - name: Setup Supabase CLI
      uses: supabase/setup-cli@v1
      with:
        version: latest

    - name: Verify Supabase Connection
      run: |
        supabase status
        supabase db version

    - name: Run Database Migrations
      run: |
        supabase db push

    - name: Run Database Tests
      run: |
        # Add your database test commands here
        # Example: psql connection or custom test script
        psql "postgresql://postgres:[YOUR-PASSWORD]@db.wizyuwbezyltaxatkupc.supabase.co:5432/postgres" -c "SELECT version();"

    # Optional: Lint database schema
    - name: Database Schema Lint
      run: |
        supabase db lint
